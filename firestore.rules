rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsExisting() { return signedIn() && resource.data.userId == request.auth.uid; }
    function ownsIncoming() { return signedIn() && request.resource.data.userId == request.auth.uid; }

    match /tasks/{taskId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming()
        && request.resource.data.status in ['pending', 'completed']
        && request.resource.data.priority in ['low', 'medium', 'high']
        && request.resource.data.reminderEnabled is bool
        && request.resource.data.reminderMinutes is int
        && request.resource.data.reminderMinutes >= 60
        && request.resource.data.reminderMinutes <= 43200;
      allow update: if ownsExisting() && ownsIncoming()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.status in ['pending', 'completed']
        && request.resource.data.priority in ['low', 'medium', 'high']
        && request.resource.data.reminderEnabled is bool
        && request.resource.data.reminderMinutes is int
        && request.resource.data.reminderMinutes >= 60
        && request.resource.data.reminderMinutes <= 43200;
    }

    match /pushTokens/{tokenId} {
      allow read, delete: if ownsExisting();
      allow create: if ownsIncoming()
        && request.resource.data.platform == 'web';
      allow update: if ownsExisting() && ownsIncoming()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.token == resource.data.token
        && request.resource.data.platform == 'web';
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
